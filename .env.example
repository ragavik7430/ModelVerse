# ==============================================================================
# ModelVerse Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace placeholders with actual values if needed.
# NEVER commit the actual .env file containing real secrets to version control.

# --- Database Configuration ---
# Format: postgresql://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgresql://modelverse_user:modelverse_password@localhost:5432/modelverse_db

# --- Backend Configuration ---
ENVIRONMENT=development
API_V1_STR=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:3000"] # JSON formatted list of origins

# --- Frontend Configuration (for reference, Next.js uses .env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Future Services (Placeholders) ---
# REDIS_URL=redis://localhost:6379/0
# QDRANT_URL=http://localhost:6333
# MLFLOW_TRACKING_URI=http://localhost:5000
